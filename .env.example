# Copy to .env.local (git-ignored). `npm run preflight` checks all of these.

# Supabase — Project Settings > API. The SERVICE key is server-side only: it
# must never appear in client code, in git, or in a group chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LINE — developers.line.biz. Secret and token are on the channel's Basic
# settings and Messaging API tabs. The owner user id is NOT shown in the
# console: message the bot once and it replies with it.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=

# Gates /dashboard and the demo endpoints. Any long random string.
DASHBOARD_KEY=

# The model. Whichever key is present decides the provider; LLM_PROVIDER
# forces one. LLM_MODEL must match the provider you end up using.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Optional. Without these, supplier drafts say email is not configured rather
# than pretending they sent.
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional. Defaults shown.
# BUSINESS_KEY=demo-import
# DEPLOY_URL=https://aibosses.vercel.app
