# Copy to .env.local (git-ignored). Values come from the Supabase dashboard:
# Project Settings → API. The SERVICE key is server-side only — it must never
# appear in client code, git, or the group chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public (safe for browser) — only needed once the frontend talks to Supabase directly, which we currently do NOT do:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# LLM
OPENAI_API_KEY=
